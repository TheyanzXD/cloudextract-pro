# ==============================================================================
# CloudExtract Pro - Environment Variables Configuration
# ==============================================================================

# 1. Vercel Blob Storage Token (Required in production)
# Generated automatically when linking Vercel Blob store, or from Vercel Project Settings > Storage > Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx"

# 2. Database Connection (PostgreSQL - Vercel Postgres / Neon / Supabase)
# In development, the app includes an in-memory/JSON store fallback if no DB is connected,
# but in production, provide a PostgreSQL connection URL.
POSTGRES_URL="postgres://default:password@ep-cool-snowflake-123456.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
# Optional poolers:
POSTGRES_PRISMA_URL="postgres://default:password@ep-cool-snowflake-123456-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgres://default:password@ep-cool-snowflake-123456.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"

# 3. Vercel Cron Secret (Required for scheduled cleanup authorization)
# Set in Vercel Project Settings > Environment Variables
CRON_SECRET="cr_sec_a8f93e921d7b4c6e80b2a3f9c7e1d5a8"

# 4. App Base URL (Used for generating public share links and canonical URLs)
NEXT_PUBLIC_APP_URL="https://cloudextract-pro.vercel.app"

# 5. Extraction Safety & Limits (Protection against Zip-Bomb and Resource Exhaustion)
# Maximum total uncompressed archive size in MB (Default: 1024 = 1GB)
MAX_EXTRACT_SIZE_MB="1024"
# Maximum number of files permitted in a single extracted archive (Default: 5000)
MAX_EXTRACT_FILE_COUNT="5000"
# Maximum compression ratio allowed (e.g., 100 means 10MB compressed cannot exceed 1GB uncompressed)
MAX_COMPRESSION_RATIO="100"
# Maximum folder nesting depth allowed during extraction
MAX_EXTRACT_DEPTH="15"

# 6. Rate Limiting & Client Limits
# Maximum requests per IP per minute
RATE_LIMIT_MAX_REQUESTS="60"
RATE_LIMIT_WINDOW_SECONDS="60"

# Maximum single file upload limit in MB displayed to client
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB="500"
# Maximum concurrent uploads from client browser (default 3 to avoid saturating network/memory)
NEXT_PUBLIC_CLIENT_CONCURRENCY="3"
